# Copy to .env (docker compose reads it). Every value is optional except a
# working LLM endpoint - without one the app still runs rules and search, but
# classification and drafting stay idle. See docs/getting-started.md for how to
# pick an endpoint for your hardware.

# --- LLM (any OpenAI-compatible /chat/completions server) ---
LLM_BASE_URL=http://127.0.0.1:8040/v1    # local server (vLLM/ollama) or a hosted API, e.g. https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=your-model-name
LLM_TIMEOUT=90
# Optional: keep a second endpoint as a safety net (used only when the primary fails)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Mailbox ---
# Defaults point at the embedded email-oauth2-proxy on 127.0.0.1:1993. Change
# these only if you point the app at your own IMAP server instead of the proxy.
IMAP_HOST=127.0.0.1
IMAP_PORT=1993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=0

# --- UI ---
UI_HOST=0.0.0.0
UI_PORT=8097
# DATA_DIR=/data                         # set in the image; change only for bare-metal runs

# --- Optional: GPU embedding/rerank servers (legacy RAG backend) ---
# The default lite backend embeds and reranks on CPU; leave these blank for it.
EMBED_BASE_URL=
EMBED_MODEL=Qwen/Qwen3-Embedding-4B
RERANK_BASE_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
