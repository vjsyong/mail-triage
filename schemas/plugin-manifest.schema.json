{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mail-triage.local/schemas/plugin-manifest.schema.json",
  "title": "Mail Triage plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "engines", "runtime",
               "entrypoint", "kind"],
  "properties": {
    "id":          { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
                     "description": "unique across roots; the 'mt-' prefix is reserved for built-ins" },
    "name":        { "type": "string", "maxLength": 64 },
    "action":      { "type": "string", "maxLength": 48,
                     "description": "short action label for assistant chips, e.g. 'Find invoices'; falls back to the plugin id" },
    "version":     { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$",
                     "description": "semver; a bump that adds permissions forces re-grant" },
    "description": { "type": "string", "maxLength": 280 },
    "author":      { "type": "string", "maxLength": 120 },
    "homepage":    { "type": "string", "format": "uri" },
    "license":     { "type": "string", "maxLength": 40 },
    "engines":     { "type": "object", "required": ["sdk"], "additionalProperties": false,
                     "properties": {
                       "sdk": { "type": "string",
                                "description": "semver range against the host SDK, e.g. '>=0.1 <1.0'" } } },
    "runtime":     { "const": "quickjs" },
    "entrypoint":  { "type": "string", "minLength": 1, "maxLength": 200,
                     "description": "relative path inside the plugin dir, ends with .js" },
    "kind":        { "type": "array", "minItems": 1, "uniqueItems": true,
                     "items": { "enum": ["tool", "classifier", "matcher",
                                         "draft-provider", "retriever", "integration"] } },
    "permissions": { "type": "array", "uniqueItems": true,
                     "items": { "enum": ["mailbox.read", "llm.complete", "llm.embed",
                                         "net.http"] },
                     "description": "v1 reach: read + propose; plugins cannot mutate mail" },
    "net":         { "type": "object", "additionalProperties": false,
                     "properties": {
                       "hosts": { "type": "array",
                                  "items": { "type": "string",
                                             "pattern": "^[a-z0-9.*-]+(:\\d+)?$" },
                                  "description": "hostname or *.suffix wildcard, optional :port" },
                       "allow_config_hosts": { "type": "boolean", "default": false,
                                  "description": "the plugin's config may extend the host allowlist (user-typed endpoints, e.g. a webhook URL)" },
                       "max_requests_per_day": { "type": "integer", "minimum": 0,
                                                 "maximum": 10000, "default": 50 } } },
    "required_llm_capability": { "enum": ["none", "llm.complete", "llm.embed"],
                                 "default": "none" },
    "limits":      { "type": "object", "additionalProperties": false,
                     "properties": {
                       "memory_mb":  { "type": "integer", "minimum": 8, "maximum": 256, "default": 64 },
                       "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 5000 },
                       "kv_bytes":   { "type": "integer", "minimum": 0, "maximum": 1048576, "default": 65536 } } },
    "config":      { "type": "object",
                     "description": "JSON Schema for per-install settings (rendered on the Plugins page)" },
    "ui":          { "type": "object", "additionalProperties": false,
                     "required": ["entrypoint"],
                     "description": "Browser page(s) served by the host under /extensions/<id>/<page>. The bundle is untrusted: the host embeds it in a sandboxed frame (no same-origin, no network) and mediates every backend call.",
                     "properties": {
                       "entrypoint": { "type": "string", "minLength": 1, "maxLength": 200,
                                       "description": "relative path to the browser page bundle (.js) inside the plugin dir" },
                       "pages":     { "type": "array", "minItems": 1,
                                      "items": { "type": "object", "additionalProperties": false,
                                                 "required": ["id", "title"],
                                                 "properties": {
                                                   "id":          { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
                                                   "title":       { "type": "string", "minLength": 1, "maxLength": 60 },
                                                   "description": { "type": "string", "maxLength": 160 } } } },
                       "navigation": { "type": "array",
                                       "items": { "type": "object", "additionalProperties": false,
                                                  "required": ["page", "label"],
                                                  "properties": {
                                                    "page":  { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
                                                    "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                                                    "group": { "enum": ["mail", "automation", "system"],
                                                               "default": "system" },
                                                    "icon":  { "enum": ["mail", "inbox", "search", "list", "tag",
                                                                        "star", "clock", "filter", "file", "puzzle",
                                                                        "sparkles", "settings"],
                                                               "default": "puzzle" },
                                                    "order": { "type": "integer", "minimum": -999,
                                                               "maximum": 999, "default": 100 } } } },
                       "operations": { "type": "array", "uniqueItems": true,
                                       "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" },
                                       "description": "declared tool names the browser page may invoke; each must exist in tools[] and be read-only (side_effects: none)" } } },
    "tools":       { "type": "array",
                     "items": { "type": "object",
                                "required": ["name", "description", "parameters"],
                                "additionalProperties": false,
                                "properties": {
                                  "name":        { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" },
                                  "description": { "type": "string", "maxLength": 400 },
                                  "parameters":  { "type": "object",
                                                   "description": "JSON Schema subset: object/string/number/integer/boolean/array/enum/required; no $ref/$defs/oneOf" },
                                  "side_effects":{ "enum": ["none", "local_write", "mailbox_write", "external"],
                                                   "default": "none" },
                                  "surface":     { "enum": ["assistant", "hidden"], "default": "assistant" },
                                  "output_schema": { "type": "object" } } } },
    "classifier":  { "type": "object", "additionalProperties": false,
                     "properties": {
                       "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" },
                                    "description": "labels this classifier can return" },
                       "inputs":  { "type": "array", "items": { "type": "string" } } } },
    "assistant":   { "type": "object", "additionalProperties": false,
                     "properties": {
                       "when_to_use": { "type": "string", "maxLength": 280 } } },
    "schedule":    { "type": "object", "additionalProperties": false,
                     "required": ["every_minutes"],
                     "description": "kernel invokes onSchedule() on this cadence while the plugin is enabled",
                     "properties": {
                       "every_minutes": { "type": "integer", "minimum": 15, "maximum": 10080 },
                       "run_tool":      { "type": "string", "maxLength": 64,
                                          "description": "tool name passed to onSchedule as a hint (default: first tool)" },
                       "enabled":       { "type": "boolean", "default": true } } }
  }
}
