{
  "note": "Build-side semantic routing. This does NOT modify the production category contract: it maps each family's intent to the policy categories whose AUTHORED definitions actually cover it, so gold is grounded in the visible policy rather than a generic role. A category may also carry explicit `roles` in the policy (e.g. the marketing-merge twin), which take precedence over the name map. If no category covers the intent the gold is a taxonomy gap, never an invented label.",
  "category_covers": {
    "Action": {"covers": ["approval", "action_request"], "by_name": true},
    "Notification": {"covers": ["notification", "alert", "security", "shipping", "project_update"], "by_name": true},
    "Newsletter": {"covers": ["newsletter"], "by_name": true},
    "Receipt": {"covers": ["receipt", "invoice", "bill", "refund"], "by_name": true},
    "Personal": {"covers": ["personal", "invitation", "meeting", "school"], "by_name": true},
    "Promo": {"covers": ["promo", "promo_ambiguous"], "by_name": true},
    "Client": {"covers": ["approval", "action_request", "support", "project", "meeting"], "by_name": false},
    "Invoice": {"covers": ["invoice", "receipt", "bill", "refund"], "by_name": true},
    "Admin": {"covers": ["admin", "document", "security", "alert", "notification"], "by_name": false},
    "Incident": {"covers": ["incident", "alert"], "by_name": true},
    "Review": {"covers": ["review", "project", "project_update", "approval"], "by_name": false},
    "Account": {"covers": ["security", "account", "support", "shipping"], "by_name": false},
    "Coursework": {"covers": ["coursework"], "by_name": true},
    "Social": {"covers": ["invitation", "meeting", "personal", "school"], "by_name": true},
    "Family": {"covers": ["personal", "family", "school", "document"], "by_name": true},
    "Bill": {"covers": ["bill", "invoice", "receipt", "refund"], "by_name": true},
    "Appointment": {"covers": ["appointment", "invitation", "meeting"], "by_name": true},
    "Order": {"covers": ["order", "approval", "action_request", "project"], "by_name": true},
    "Supplier": {"covers": ["supplier", "shipping", "notification", "support", "document"], "by_name": false},
    "Marketing": {"covers": ["promo", "marketing", "promo_ambiguous"], "by_name": true},
    "Alert": {"covers": ["alert", "security", "incident", "project_update"], "by_name": false},
    "Event": {"covers": ["invitation", "event", "meeting", "school", "appointment"], "by_name": true},
    "Volunteer": {"covers": ["volunteer", "action_request", "approval", "project"], "by_name": false},
    "Donation": {"covers": ["receipt", "donation", "invoice", "bill", "refund"], "by_name": true},
    "Application": {"covers": ["application", "approval", "interview", "meeting"], "by_name": false},
    "Recruiter": {"covers": ["recruiter", "support", "document"], "by_name": false}
  },
  "family_intent": {
    "receipt_confirmation": ["receipt"],
    "invoice_receipt": ["invoice"],
    "payment_reminder": ["bill"],
    "refund_status": ["refund"],
    "newsletter_digest": ["newsletter"],
    "legitimate_promo": ["promo"],
    "ambiguous_marketing": ["promo", "newsletter"],
    "suspicious_phishing": ["security", "promo", "notification"],
    "security_notification": ["security"],
    "shipping_travel_update": ["shipping"],
    "support_exchange": ["support"],
    "document_request": ["document"],
    "order_request": ["order"],
    "request_approval": ["approval"],
    "project_request": ["project"],
    "project_status": ["project_update"],
    "operational_alert": ["alert"],
    "meeting_request": ["meeting"],
    "personal_invitation": ["invitation"],
    "school_community": ["school"],
    "event_registration": ["invitation"]
  }
}
