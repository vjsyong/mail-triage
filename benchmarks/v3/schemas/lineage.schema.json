{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "benchmark v3 lineage group",
 "type": "object",
 "required": ["schema_version", "lineage_id", "root_id", "members",
              "source_message_ids", "relation_type"],
 "additionalProperties": true,
 "properties": {
  "schema_version": {"const": "v3.0"},
  "lineage_id": {"type": "string", "minLength": 1},
  "root_id": {"type": "string", "minLength": 1},
  "members": {
   "type": "array",
   "minItems": 1,
   "items": {"type": "string", "minLength": 1}
  },
  "source_message_ids": {"type": "array", "items": {"type": "string"}},
  "relation_type": {"enum": ["root", "invariance", "counterfactual",
                             "duplicate", "clip_variant"]},
  "partition": {"enum": ["development", "calibration", "private_test",
                         "private_shift", "real_holdout"]},
  "notes": {"type": "string"}
 }
}
