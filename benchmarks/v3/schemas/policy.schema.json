{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "benchmark v3 policy card",
 "type": "object",
 "required": ["schema_version", "policy_id", "revision", "owner", "categories",
              "filing", "permissions"],
 "additionalProperties": true,
 "properties": {
  "schema_version": {"const": "v3.0"},
  "policy_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
  "revision": {"type": "string", "minLength": 1},
  "owner": {"type": "string", "minLength": 1},
  "persona": {"type": "string"},
  "categories": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["name", "description", "folder"],
    "additionalProperties": true,
    "properties": {
     "name": {"type": "string", "minLength": 1},
     "description": {"type": "string", "minLength": 1},
     "folder": {"type": "string", "minLength": 1}
    }
   }
  },
  "filing": {
   "type": "object",
   "required": ["default_folder", "mode"],
   "additionalProperties": true,
   "properties": {
    "default_folder": {"type": "string", "minLength": 1},
    "mode": {"enum": ["suggest", "ask", "auto"]},
    "confidence_gate": {"type": "number", "minimum": 0, "maximum": 1}
   }
  },
  "permissions": {
   "type": "object",
   "required": ["allow_move", "allow_send", "allow_rule_create", "require_approval"],
   "additionalProperties": true,
   "properties": {
    "allow_move": {"type": "boolean"},
    "allow_send": {"type": "boolean"},
    "allow_rule_create": {"type": "boolean"},
    "require_approval": {"type": "boolean"}
   }
  },
  "notes": {"type": "string"}
 }
}
