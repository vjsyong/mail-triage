{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "benchmark v3 run manifest",
 "type": "object",
 "required": ["schema_version", "dataset_id", "dataset_sha256",
              "case_manifest_sha256", "prompt_revision", "prompt_sha256",
              "model_key", "model_revision", "model_artifact_sha256",
              "adapter_id", "adapter_revision", "scorer_revision",
              "policy_revision", "policy_sha256", "engine_contract_sha256",
              "calibrator_revision", "generation_config", "runtime_config",
              "requested_case_ids", "requested_splits", "requested_profiles",
              "config_hash", "run_id"],
 "additionalProperties": true,
 "properties": {
  "schema_version": {"const": "v3.0"},
  "dataset_id": {"type": "string", "minLength": 1},
  "dataset_sha256": {"type": "string", "minLength": 1},
  "case_manifest_sha256": {"type": "string", "minLength": 1},
  "prompt_revision": {"type": "string", "minLength": 1},
  "prompt_sha256": {"type": "string", "minLength": 1},
  "model_key": {"type": "string", "minLength": 1},
  "model_revision": {"type": "string"},
  "model_artifact_sha256": {"type": "string"},
  "adapter_id": {"type": "string", "minLength": 1},
  "adapter_revision": {"type": "string", "minLength": 1},
  "scorer_revision": {"type": "string", "minLength": 1},
  "policy_revision": {"type": "string", "minLength": 1},
  "policy_sha256": {"type": "string", "minLength": 1},
  "engine_contract_sha256": {"type": "string", "minLength": 1},
  "calibrator_revision": {"type": "string", "minLength": 1},
  "generation_config": {"type": "object"},
  "runtime_config": {"type": "object"},
  "requested_case_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
  "requested_splits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
  "requested_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
  "config_hash": {"type": "string", "minLength": 8},
  "run_id": {"type": "string", "minLength": 3}
 }
}
